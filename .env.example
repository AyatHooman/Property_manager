# Copy this file to ".env" (which is gitignored) and fill in real values.
# All secrets/keys live ONLY in .env — never commit real values to git.

# Domain API Credentials — register at https://developer.domain.com.au
DOMAIN_CLIENT_ID=your_client_id_here
DOMAIN_CLIENT_SECRET=your_client_secret_here

# Shared access token gating the web app (any non-empty value enables the gate)
AUTH_TOKEN=change-me

# OpenRouteService key for walk/bike routing — free at https://openrouteservice.org
ORS_API_KEY=your_ors_key_here

# Groq API key for voice transcription (Whisper) — free at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: route scraper through a proxy to bypass IP blocks
# SCRAPER_PROXY=http://127.0.0.1:8080
